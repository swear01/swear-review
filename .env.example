# ---- GitHub App ----
# Create the app at https://github.com/settings/apps/new
GITHUB_APP_ID=123456

# PEM content inline (replace \n with real newlines) OR a path to the .pem file
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
# GITHUB_APP_PRIVATE_KEY=<inline PEM omitted; use GITHUB_APP_PRIVATE_KEY_PATH>

# Any random string; must match the one configured in the GitHub App settings
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- OpenCode Go (DeepSeek V4 Flash) ----
# https://opencode.ai — only ever lives on the server
OPENCODE_GO_KEY=sk-example-do-not-use

# ---- Swear Review ----
PORT=3000
CONFIG_PATH=./config.yaml
DATABASE_PATH=./data/swear-review.db
LOG_LEVEL=info

# Path/binary of the OCR CLI (default: `ocr` on PATH)
# OCR_BIN=ocr
