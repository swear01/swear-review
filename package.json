{
  "name": "swear-review",
  "version": "1.0.0",
  "description": "GitHub-native AI code review bot. Thin, reliable product layer around Alibaba Open Code Review (OCR) + OpenCode Go / DeepSeek V4 Flash.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "swear-review": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "echo 'Reminder: install OCR globally: npm i -g @alibaba-group/open-code-review@1.9.0'"
  },
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/webhooks": "^14.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "micromatch": "^4.0.8",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
